# package-lock.json is generated with legacy peer resolution. @lovable.dev/vite-tanstack-config
# declares nitro ">=3.0.260603-beta", which semver prerelease rules do not match for the newer
# pinned beta, so plain `npm ci` would stop with ERESOLVE. Lovable installs with bun (bun.lock).
legacy-peer-deps=true
